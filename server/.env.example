# Erovians — server/ environment variables
#
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# This file documents every variable the server currently reads, grouped by
# concern. Nothing below removes or replaces an existing Postgres variable;
# the MONGO_* block is new (Milestone 1 infrastructure) and additive only.

# ── Server ──
NODE_ENV=development
PORT=9080
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ── PostgreSQL (Prisma) — unchanged, still the primary datastore ──
DATABASE_URL=postgresql://user:password@localhost:5432/erovians

# ── MongoDB (new — Milestone 1 infrastructure) ──
# Connects to the local MongoDB Community Server defined in
# infrastructure/mongodb/compose.yaml. Not yet load-bearing: no repository
# or business logic reads from Mongo yet, so the app runs fine even if this
# is left unset or the container isn't running (see server/src/config/mongodb.js).
# Credentials here must match infrastructure/mongodb/.env's MONGO_DB_NAME /
# MONGO_USER / MONGO_PASSWORD — this is the least-privilege app user, never
# the cluster root user.
MONGO_URI=mongodb://erovians_app:changeme_use_a_long_random_value_too@localhost:27017/erovians?replicaSet=erovians-rs0&authSource=erovians
MONGO_DB_NAME=erovians
MONGO_USER=erovians_app
MONGO_PASSWORD=changeme_use_a_long_random_value_too
MONGO_AUTH_SOURCE=erovians

# ── JWT — User (unchanged) ──
USER_ACCESS_TOKEN_SECRET=
USER_REFRESH_TOKEN_SECRET=

# ── JWT — Admin (unchanged) ──
ADMIN_ACCESS_TOKEN_SECRET=
ADMIN_REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Cookies ──
COOKIE_DOMAIN=localhost

# ── chat-server (service-to-service) ──
CHAT_SERVER_URL=http://localhost:5001
CHAT_INTERNAL_SECRET=
INTERNAL_SECRET=

# ── Encryption (message content — value must match chat-server's) ──
ENCRYPTION_KEY=

# ── Redis (Upstash) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudinary (media storage) ──
CLOUDINARY_CLIENT_NAME=
CLOUDINARY_CLIENT_API=
CLOUDINARY_CLIENT_SECRET=

# ── Firebase Admin (Google OAuth verification) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Email (Brevo) ──
BREVO_SENDER_EMAIL=
BREVO_API_KEY=

# ── SMS (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI / transcription (Groq) ──
GROQ_API_KEY=

# ── Admin alerting ──
ADMIN_ALERT_EMAIL=
