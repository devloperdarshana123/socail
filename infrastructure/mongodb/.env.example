# Erovians — infrastructure/mongodb environment variables
#
# Copy to `.env` in this same directory (infrastructure/mongodb/.env) and
# fill in real values. `docker compose` reads a .env file automatically
# from the directory it's run in. Never commit the real .env file.
#
# These are infrastructure-level credentials only. The root user defined
# here is used to bootstrap the cluster and to run the one-time mongo-init
# job — the backend application (server/) never authenticates as root; it
# only ever uses the least-privilege application user created by init.js.
# See server/.env.example for the application-facing MONGO_* variables.

# ── Cluster root superuser (infra-only — never used by the app) ──
MONGO_ROOT_USER=erovians_root
MONGO_ROOT_PASSWORD=changeme_use_a_long_random_value

# ── Replica set ──
MONGO_REPLICA_SET_NAME=erovians-rs0

# ── Host port mapping ──
MONGO_PORT=27017

# ── Application database + user (created by mongo-init/init.js) ──
# Keep these in sync with the matching MONGO_DB_NAME / MONGO_USER /
# MONGO_PASSWORD values in server/.env — they must be the same credentials.
MONGO_DB_NAME=erovians
MONGO_USER=erovians_app
MONGO_PASSWORD=changeme_use_a_long_random_value_too
